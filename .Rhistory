species = "hg38",
additional.metrics = FALSE,
reduce = 1000)
codon_usage <- tTEscanR_obj@assays$CodonUsage
codon_background <- rowSums(codon_usage) / sum(rowSums(codon_usage))
codon_background_relative_cont <- data.frame(codon = names(codon_background),
freq = as.numeric(codon_background),
row.names = NULL)
codon_background_relative_cont
significance <- ObtainSignificance(dist = permutation_test,
value = codon_background_relative_cont)
